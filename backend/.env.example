# Copy to backend/.env and fill in. Nothing here reaches the browser.
#
# These used to be named GIGEZEE_*, from before the rename. config.py
# still reads the old names as a fallback, but use KOODAM_* for anything
# new: an unread setting silently falls back to a default, which is how
# KOODAM_ADMIN_EMAILS ended up empty and locked staff out of the
# escalations console.

# ---------------------------------------------------------------
# Database — the Supabase connection string (use the pooler URL)
# ---------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------
# Supabase — the service role key, used to store avatars. Treat it as a
# root password: it bypasses row level security.
# ---------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------
# Firebase — the project whose sign-in tokens this backend accepts.
# Falls back to VITE_FIREBASE_PROJECT_ID in the frontend .env.
# ---------------------------------------------------------------
FIREBASE_PROJECT_ID=

# ---------------------------------------------------------------
# Deployed frontend origins allowed to call this API, comma-separated
# (e.g. https://koodam.vercel.app). localhost is always allowed.
# ---------------------------------------------------------------
ALLOWED_ORIGINS=

# ---------------------------------------------------------------
# Razorpay — the secret never leaves the server
# ---------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------------------------------------------------------------
# Pricing. These must match what the app shows, which it reads from
# GET /config rather than hardcoding.
# ---------------------------------------------------------------
KOODAM_TRUST_FEE=20
KOODAM_PLATFORM_COMMISSION_PERCENT=10

# ---------------------------------------------------------------
# KOODAM staff, by sign-in email, comma-separated. Required for the
# escalations console and for reading crash reports — with this empty,
# every /admin endpoint returns 403 to everyone.
# ---------------------------------------------------------------
KOODAM_ADMIN_EMAILS=

# ---------------------------------------------------------------
# Rate limits, as requests/seconds per caller. Defaults shown.
# auth covers sign-up and crash reports; write covers bookings,
# payments and profile edits; read covers everything else.
# ---------------------------------------------------------------
KOODAM_RATE_AUTH=10/60
KOODAM_RATE_WRITE=90/60
KOODAM_RATE_READ=300/60

# ---------------------------------------------------------------
# Backups — where scripts/backup_database.py writes, and how many it
# keeps. On Render, point this at a mounted disk.
# ---------------------------------------------------------------
KOODAM_BACKUP_DIR=
KOODAM_BACKUP_KEEP=14

# ---------------------------------------------------------------
# Phone booking (offline mode), via Twilio
# ---------------------------------------------------------------
KOODAM_IVR_NUMBER=
KOODAM_IVR_PUBLIC_URL=
TWILIO_AUTH_TOKEN=

# ---------------------------------------------------------------
# Partner escalations and penalties. Defaults are in app/config.py;
# set these only to override.
# ---------------------------------------------------------------
# KOODAM_COMPLAINT_RESPONSE_HOURS=24
# KOODAM_JOB_START_GRACE_HOURS=2
# KOODAM_JOB_FINISH_GRACE_HOURS=12
# KOODAM_STRIKES_TO_SUSPEND=3
# KOODAM_SUSPENSION_DAYS=7
