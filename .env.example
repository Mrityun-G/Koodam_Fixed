# Copy to .env and fill in. Everything here is sent to the browser, so
# only ever put publishable values in a VITE_ variable — secrets belong
# in backend/.env, which is never bundled.

# Live map tiles come from OpenStreetMap via Leaflet — no API key needed.

# ---------------------------------------------------------------
# Firebase (sign-in, live GPS relay, KYC document storage)
# Realtime Database must be created (Build > Realtime Database) for
# live GPS to work, and its rules deployed — see firebase/README.md.
# ---------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------
# GigEzee backend
# Leave unset locally to use http://127.0.0.1:8000. A built APK cannot
# reach 127.0.0.1, so .env.production must point at the deployed API.
# ---------------------------------------------------------------
VITE_BACKEND_URL=

# ---------------------------------------------------------------
# Supabase (Google sign-in, avatar hosting)
# The anon key is publishable by design. It must NOT be able to read
# any table — run backend/migrations/002_row_level_security.py once.
# ---------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------
# Razorpay — the key id only. The secret stays in backend/.env.
# ---------------------------------------------------------------
VITE_RAZORPAY_KEY_ID=

# ---------------------------------------------------------------
# Analytics (optional)
# Unset means no analytics are loaded at all. A GA4 measurement id
# turns on screen and funnel events; nothing identifying is ever sent.
# ---------------------------------------------------------------
VITE_GA_MEASUREMENT_ID=

# ---------------------------------------------------------------
# Crash reporting (optional)
# Crashes always go to the GigEzee backend at /client-errors. Setting a
# Sentry DSN forwards them there as well.
# ---------------------------------------------------------------
VITE_SENTRY_DSN=

# Stamped onto crash reports and analytics so a fault can be tied to a
# build. In CI, set this to the commit sha.
VITE_APP_VERSION=

# Optional self-hosted OSRM for driving routes; falls back to a straight
# line estimate when unset.
VITE_OSRM_URL=

# ---------------------------------------------------------
# Backend (backend/.env, or the host's environment on Render)
# ---------------------------------------------------------
# GigEzee AI reads a photo of the broken thing. Unset means the feature
# is off and members pick a service themselves.
ANTHROPIC_API_KEY=

# Serve canned diagnoses instead of calling Claude, for testing the
# camera flow with no API key and no charges. Answers are fixed text,
# marked [DEV FAKE] in summary_for_partner. Ignored once
# ANTHROPIC_API_KEY is set. Never leave this on in real use.
GIGEZEE_FAKE_AI=

