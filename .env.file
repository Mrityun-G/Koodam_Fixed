# Live map tiles come from OpenStreetMap via Leaflet — no API key needed.

# Firebase project config (Project Settings > General > Your apps > SDK setup and config)
# Realtime Database must be created (Build > Realtime Database) for live GPS relay to work.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
